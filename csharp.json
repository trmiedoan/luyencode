      "using System;",
      "using System.IO;",
      "",
      "public class Solution",
      "{",
      "\t// Hàm xử lý chính: Nhận vào luồng đọc và luồng ghi",
      "\tpublic void Solve(TextReader reader, TextWriter writer)",
      "\t{",
      "\t\t// Đọc dữ liệu đầu vào",
      "\t\tstring input = reader.ReadLine();",
      "\t\tif (string.IsNullOrEmpty(input)) return;",
      "",
      "\t\tstring[] parts = input.Split(' ');",
      "\t\tint a = int.Parse(parts[0]);",
      "\t\tint b = int.Parse(parts[1]);",
      "",
      "\t\t// Xử lý logic bài toán và ghi kết quả ra luồng writer",
      "\t\twriter.Write($\"{a}\");",
      "\t\t$0",
      "\t}",
      "",
      "\t// Hàm Main này CHỈ chạy trên Online Judge (Chế độ Release)",
      "\t#if !DEBUG",
      "\tpublic static void Main(string[] args)",
      "\t{",
      "\t\tSolution solver = new Solution();",
      "\t\t// Khi nộp lên OJ, truyền Console.In (bàn phím) và Console.Out (màn hình) vào",
      "\t\tsolver.Solve(Console.In, Console.Out);",
      "\t}",
      "\t#endif",
      "}"
    ],
    "description": "C# template dạng Solution với Solve(TextReader, TextWriter) và Main chỉ chạy khi !DEBUG."
  },
