  "C# FastIO Template": {
    "prefix": "csharp-fastio",
    "body": [
      "using System;",
      "using System.IO;",
      "",
      "namespace LuyenCodeProject",
      "{",
      "\tpublic class ${TM_FILENAME_BASE}",
      "\t{",
      "\t\tpublic static void Main()",
      "\t\t{",
      "\t\t\t// Tự động chuyển hướng file khi chạy Local, khi nộp OJ sẽ tự bỏ qua",
      "\t\t\t#if DEBUG",
      "\t\t\tif (File.Exists(\"input.txt\"))",
      "\t\t\t{",
      "\t\t\t\tConsole.SetIn(new StreamReader(\"input.txt\"));",
      "\t\t\t\tConsole.WriteLine(\"Reading from input.txt\");",
      "\t\t\t}",
      "\t\t\t#endif",
      "",
      "\t\t\tFastScanner scanner = new FastScanner();",
      "",
      "\t\t\t// Đọc dữ liệu cực nhanh và an toàn",
      "\t\t\t$0",
      "\t\t}",
      "\t}",
      "",
      "\t// Lớp hỗ trợ đọc dữ liệu tốc độ cao (Fast I/O)",
      "\tpublic class FastScanner",
      "\t{",
      "\t\t// Đổi từ StreamReader sang TextReader để tương thích hoàn hảo với Console.In",
      "\t\tprivate readonly TextReader _reader;",
      "\t\tprivate readonly char[] _buffer = new char[32768];",
      "\t\tprivate int _head, _tail;",
      "",
      "\t\tpublic FastScanner()",
      "\t\t{",
      "\t\t\t// Gán thẳng bằng Console.In.",
      "\t\t\t// Nếu bạn dùng Console.SetIn(file) ở trên, nó sẽ tự động đọc file.",
      "\t\t\t// Khi nộp lên LeetCode, Console.In chính là luồng nhận dữ liệu của hệ thống chấm bài.",
      "\t\t\t_reader = Console.In;",
      "\t\t}",
      "",
      "\t\tprivate char ReadChar()",
      "\t\t{",
      "\t\t\tif (_head >= _tail)",
      "\t\t\t{",
      "\t\t\t\t_head = 0;",
      "\t\t\t\t_tail = _reader.Read(_buffer, 0, _buffer.Length);",
      "\t\t\t\tif (_tail <= 0) return '\\\\0';",
      "\t\t\t}",
      "\t\t\treturn _buffer[_head++];",
      "\t\t}",
      "",
      "\t\t// 1. Đọc một chuỗi/từ (bỏ qua khoảng trắng)",
      "\t\tpublic string NextToken()",
      "\t\t{",
      "\t\t\tchar c;",
      "\t\t\twhile ((c = ReadChar()) <= ' ' && c != '\\\\0') ;",
      "\t\t\tif (c == '\\\\0') return null;",
      "",
      "\t\t\tvar sb = new System.Text.StringBuilder();",
      "\t\t\tdo { sb.Append(c); } while ((c = ReadChar()) > ' ');",
      "\t\t\treturn sb.ToString();",
      "\t\t}",
      "",
      "\t\t// 2. Đọc số nguyên 32-bit",
      "\t\tpublic int NextInt()",
      "\t\t{",
      "\t\t\tchar c;",
      "\t\t\twhile ((c = ReadChar()) <= ' ' && c != '\\\\0') ;",
      "\t\t\tif (c == '\\\\0') return 0;",
      "",
      "\t\t\tbool neg = false;",
      "\t\t\tif (c == '-') { neg = true; c = ReadChar(); }",
      "",
      "\t\t\tint res = 0;",
      "\t\t\tdo { res = res * 10 + (c - '0'); } while ((c = ReadChar()) > ' ');",
      "\t\t\treturn neg ? -res : res;",
      "\t\t}",
      "",
      "\t\t// 3. Đọc số nguyên 64-bit (LONG)",
      "\t\tpublic long NextLong()",
      "\t\t{",
      "\t\t\tchar c;",
      "\t\t\twhile ((c = ReadChar()) <= ' ' && c != '\\\\0') ;",
      "\t\t\tif (c == '\\\\0') return 0;",
      "",
      "\t\t\tbool neg = false;",
      "\t\t\tif (c == '-') { neg = true; c = ReadChar(); }",
      "",
      "\t\t\tlong res = 0;",
      "\t\t\tdo { res = res * 10 + (c - '0'); } while ((c = ReadChar()) > ' ');",
      "\t\t\treturn neg ? -res : res;",
      "\t\t}",
      "",
      "\t\t// 4. Đọc số thực (Double) - Dùng ép kiểu từ chuỗi",
      "\t\tpublic double NextDouble()",
      "\t\t{",
      "\t\t\tstring token = NextToken();",
      "\t\t\treturn token == null ? 0 : double.Parse(token, System.Globalization.CultureInfo.InvariantCulture);",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "C# Preamble template với FastScanner (NextToken, NextInt, NextLong, NextDouble), dùng Console.In và #if DEBUG để tự động đọc từ input.txt khi chạy local."
  },
  "C# Solution Template": {
